{
  "version": 1,
  "about": "E9 layer registry. Adding a layer is an entry here, not code. kind: h3-cells (file per horizon from the data build), geojson (static outline), points-binary (packed point records with an index.json describing the layout; built by crc_lab.storm_events).",
  "basemap": {
    "style": "https://tiles.openfreemap.org/styles/positron",
    "attribution": "Basemap \u00a9 OpenFreeMap, \u00a9 OpenMapTiles, data \u00a9 OpenStreetMap contributors"
  },
  "defaults": {
    "hazard": "tx_max",
    "horizon": 2050,
    "return_period": 100
  },
  "layers": [
    {
      "id": "texas",
      "kind": "geojson",
      "title": "Texas boundary",
      "file": "data/texas.geojson",
      "source": "U.S. Census Bureau, TIGER/Line cartographic boundary cb_2024_us_state_500k",
      "licence": "Public domain (U.S. government work)",
      "style": {
        "line": [
          42,
          42,
          40,
          255
        ],
        "width": 1.5
      },
      "on": true
    },
    {
      "id": "tx_max",
      "kind": "h3-cells",
      "title": "Hottest day of the year",
      "file": "data/hazards/tx_max/{horizon}.json",
      "source": "CRC Open",
      "licence": "CC BY-NC 4.0",
      "display": {
        "unit": "\u00b0C",
        "offset": -273.15
      },
      "style": {
        "hue": 30,
        "chroma": 0.16
      },
      "on": true
    },
    {
      "id": "tn_min",
      "kind": "h3-cells",
      "title": "Coldest night of the year",
      "file": "data/hazards/tn_min/{horizon}.json",
      "source": "CRC Open",
      "licence": "CC BY-NC 4.0",
      "display": {
        "unit": "\u00b0C",
        "offset": -273.15
      },
      "style": {
        "hue": 265,
        "chroma": 0.14
      },
      "on": true
    },
    {
      "id": "rx1day",
      "kind": "h3-cells",
      "title": "Wettest day of the year",
      "file": "data/hazards/rx1day/{horizon}.json",
      "source": "CRC Open",
      "licence": "CC BY-NC 4.0",
      "style": {
        "hue": 235,
        "chroma": 0.14
      },
      "on": true
    },
    {
      "id": "rflood",
      "kind": "h3-cells",
      "title": "River flood depth",
      "file": "data/hazards/rflood/{horizon}.json",
      "source": "CRC Open",
      "licence": "CC BY-NC 4.0",
      "style": {
        "hue": 215,
        "chroma": 0.13
      },
      "on": true
    },
    {
      "id": "wind_max_daily_max",
      "kind": "h3-cells",
      "title": "Strongest daily wind",
      "file": "data/hazards/wind_max_daily_max/{horizon}.json",
      "source": "CRC Open",
      "licence": "CC BY-NC 4.0",
      "style": {
        "hue": 300,
        "chroma": 0.13
      },
      "on": true
    },
    {
      "id": "fwi",
      "kind": "h3-cells",
      "title": "Fire weather index, annual maximum",
      "file": "data/hazards/fwi/{horizon}.json",
      "source": "CRC Open",
      "licence": "CC BY-NC 4.0",
      "style": {
        "hue": 15,
        "chroma": 0.16
      },
      "on": true
    },
    {
      "id": "spei",
      "kind": "h3-cells",
      "title": "Drought index (SPEI)",
      "file": "data/hazards/spei/{horizon}.json",
      "source": "CRC Open",
      "licence": "CC BY-NC 4.0",
      "style": {
        "hue": 150,
        "chroma": 0.12
      },
      "on": true
    },
    {
      "id": "hot_days",
      "kind": "h3-cells",
      "title": "Hot days per year",
      "file": "data/hazards/hot_days/{horizon}.json",
      "source": "CRC Open",
      "licence": "CC BY-NC 4.0",
      "style": {
        "hue": 45,
        "chroma": 0.15
      },
      "on": true
    },
    {
      "id": "hail_size",
      "kind": "h3-cells",
      "title": "Largest hail of the year (reports, 1996\u20132025)",
      "file": "data/hazards/hail_size/{horizon}.json",
      "source": "crc-lab curves from NOAA Storm Events reports",
      "licence": "Derived from U.S. government data; attribution to NOAA NCEI",
      "horizons": [
        2025
      ],
      "style": {
        "hue": 330,
        "chroma": 0.15
      },
      "caveat": "Built from storm reports, not measurements: an empty cell may be unobserved. Annual maxima per cell, pooled with the six neighbouring cells, Gumbel with a zero atom (see data/curves/hail_size.card.json).",
      "on": true
    },
    {
      "id": "thunderstorm_gust",
      "kind": "h3-cells",
      "title": "Strongest thunderstorm wind of the year (reports, 1996\u20132025)",
      "file": "data/hazards/thunderstorm_gust/{horizon}.json",
      "source": "crc-lab curves from NOAA Storm Events reports",
      "licence": "Derived from U.S. government data; attribution to NOAA NCEI",
      "horizons": [
        2025
      ],
      "style": {
        "hue": 285,
        "chroma": 0.14
      },
      "caveat": "Built from storm reports (mostly estimated gusts), not measurements: an empty cell may be unobserved. Pooled with the six neighbouring cells, Gumbel with a zero atom (see data/curves/thunderstorm_gust.card.json).",
      "on": true
    },
    {
      "id": "storm_events",
      "kind": "points-binary",
      "title": "Storm Events (NOAA reports)",
      "file": "data/storm-events/events.bin",
      "index": "data/storm-events/index.json",
      "source": "NOAA NCEI Storm Events Database, cleaned by crc-lab",
      "licence": "U.S. government work; attribution requested",
      "detail_url": "https://www.ncei.noaa.gov/stormevents/eventdetails.jsp?id={event_id}",
      "style": {
        "colors": {
          "Hail": [
            42,
            120,
            214
          ],
          "Thunderstorm Wind": [
            235,
            104,
            52
          ],
          "Tornado": [
            232,
            123,
            164
          ],
          "Flash Flood": [
            27,
            175,
            122
          ],
          "Flood": [
            237,
            161,
            0
          ]
        },
        "other": [
          122,
          121,
          118
        ]
      },
      "default_types": [
        "Hail",
        "Thunderstorm Wind"
      ],
      "on": false
    }
  ],
  "planned": [
    {
      "id": "solar_farms",
      "title": "Solar farms",
      "status": "planned (Phase 4): USGS / Berkeley Lab database"
    }
  ]
}
